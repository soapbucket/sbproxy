Output "docs/assets/ai-policy-cel.gif"

Require curl

Set Shell "bash"
Set FontSize 16
Set Width 1280
Set Height 600
Set Padding 24
Set TypingSpeed 30ms
Set Theme { "name": "sbproxy", "background": "#0d0d0f", "foreground": "#e6e6e6", "cursor": "#ffb454", "selection": "#2a2a33", "black": "#1a1a1f", "red": "#ff6b6b", "green": "#a8d96a", "yellow": "#ffb454", "blue": "#7aa2f7", "magenta": "#bb9af7", "cyan": "#7dcfff", "white": "#e6e6e6", "brightBlack": "#5c5c66", "brightRed": "#ff8888", "brightGreen": "#c3f088", "brightYellow": "#ffd194", "brightBlue": "#9bb8ff", "brightMagenta": "#d4b8ff", "brightCyan": "#a4e0ff", "brightWhite": "#ffffff" }

Hide
Type `export PS1='$ '; clear`
Enter
Show

Type `curl -s http://127.0.0.1:8080/v1/chat/completions -H 'Host: ai.local' -H 'Content-Type: application/json' -H 'Authorization: Bearer sk-demo-app-key' -H 'SB-Attr-Risk-Tier: free' -d '{"model":"gpt-4o","messages":[{"role":"user","content":"Hi"}]}' | jq -r '.model'`
Enter
Sleep 3.5s

Type `curl -s http://127.0.0.1:8080/v1/chat/completions -H 'Host: ai.local' -H 'Content-Type: application/json' -H 'Authorization: Bearer sk-demo-app-key' -H 'SB-Attr-Risk-Tier: standard' -d '{"model":"gpt-4o","messages":[{"role":"user","content":"Hi"}]}' | jq -r '.model'`
Enter
Sleep 3.5s

