# CI smoke-test image for the sbproxy Kubernetes operator.
#
# Built by the `k8s-operator-smoke` Makefile target, which is local-only:
# no CI workflow builds this image, and no release publishes it. The target
# produces the binary on the host first, then wraps it:
#
#   cargo build --profile release-fast -p sbproxy-k8s-operator --locked
#   docker build -t sbproxy-operator:ci \
#     -f crates/sbproxy-k8s-operator/Dockerfile.ci \
#     .
#
# It then loads `sbproxy-operator:ci` into a kind cluster and installs
# deploy/helm/sbproxy against it. Operators who want the image in a real
# cluster run the same two commands with their own tag and push it; see
# docs/kubernetes.md.
#
# The build context is the repository root so the COPY can reach
# `target/${CARGO_PROFILE}/sbproxy-k8s-operator` without a flat directory copy.
# Keep this image small: kind only needs a one-shot binary that talks to
# the in-cluster API server.
#
# syntax=docker/dockerfile:1.7
ARG CARGO_PROFILE=release-fast
FROM gcr.io/distroless/cc-debian12:nonroot
ARG CARGO_PROFILE=release-fast
COPY target/${CARGO_PROFILE}/sbproxy-k8s-operator /usr/local/bin/sbproxy-k8s-operator
ENTRYPOINT ["/usr/local/bin/sbproxy-k8s-operator"]
