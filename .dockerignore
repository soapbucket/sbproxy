# Excluded from docker build context to keep builds fast and avoid
# shipping 30+ GB of cargo artefacts to the daemon. Only affects `docker
# build`, not regular cargo workflows.
target/
**/target/
.worktrees/
.git/
.github/
*.log

# Container builds take their Rust version from their `FROM rust:<version>`
# tag. Shipping the repo-root pin into the context would make rustup
# override that tag inside the image and pull a second toolchain on every
# build, so the declared base image would stop being what built the binary.
rust-toolchain.toml
