target/
*.swp
.DS_Store

# The fuzz crate is a standalone (non-workspace) Cargo project with
# its own lockfile. Keeping the lockfile out of git mirrors the
# convention for the rest of the workspace (Cargo.lock at the root
# is tracked; standalone helper crates lock their own deps locally).
fuzz/Cargo.lock

# Generated test material under examples/ (cert generation scripts emit
# real keys into these dirs; we keep the scripts in git but never the
# keys themselves).
examples/*/certs/

.claude/

# curl cookie jars from running the examples/docs commands; never commit
cookies.txt

# scripts/capture-admin-screenshots.mjs resolves puppeteer from the
# workspace root, so a capture run installs it here.
node_modules/

# scripts/certify-selfhost.sh writes per-lane logs and captured host
# metadata here. The evidence is retained with the certification record
# in docs/model-host-certification.md, not in git: the logs are large,
# machine-specific, and can carry generated admin passwords.
.cert-evidence/

# Python bytecode from scripts/tests. Regenerated on every run and
# tagged with the interpreter version, so it churns per machine.
__pycache__/
*.pyc
