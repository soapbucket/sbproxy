      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (target, result) (increase(sbproxy_config_authority_rollback_total[1h]))",
          "legendFormat": "{{target}} {{result}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "description": "Fleet rollbacks the config authority was asked to run, by target and result. target=\"previous\" is the one-step undo; target=\"archived\" is POST /admin/config-authority/rollback with a to_revision naming an entry in the archive ring. result=\"refused\" means nothing was published and the revision counter did not move: usually a revision the ring no longer holds, or an older payload that stopped validating after a binary upgrade. Read the authority log for which. This is the authority's own view; sbproxy_config_apply_total on each node says whether the fleet took the new revision."
    },
    {
      "id": 16,
      "title": "Operator Fallback Probes",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 56
      },
      "datasource": {
