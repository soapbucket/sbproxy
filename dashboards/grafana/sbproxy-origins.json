{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    }
  ],
  "id": null,
  "uid": "sbproxy-origins",
  "title": "SBProxy Origins",
  "description": "Per-origin metrics for request rate, latency, and error rate.",
  "tags": [
    "sbproxy",
    "origins"
  ],
  "style": "dark",
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "10s",
  "version": 1,
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "title": "Per-Origin Request Rate",
      "type": "timeseries",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false,
            "drawStyle": "line",
            "pointSize": 5,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (origin) (rate(sbproxy_origin_requests_total[5m]))",
          "legendFormat": "{{origin}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "description": "Measures Per-Origin Request Rate. Runbook: docs/operator-runbook.md#origins. When red, inspect the matching component, confirm healthy range, and follow the rollback guidance if the spike follows a config change."
    },
    {
      "id": 2,
      "title": "Per-Origin Latency (P95)",
      "type": "timeseries",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false,
            "drawStyle": "line",
            "pointSize": 5,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, origin) (rate(sbproxy_origin_request_duration_seconds_bucket[5m])))",
          "legendFormat": "P95 - {{origin}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "description": "Measures Per-Origin Latency (P95). Runbook: docs/operator-runbook.md#origins. When red, inspect the matching component, confirm healthy range, and follow the rollback guidance if the spike follows a config change."
    },
    {
      "id": 3,
      "title": "Per-Origin Error Rate",
      "type": "timeseries",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false,
            "drawStyle": "line",
            "pointSize": 5,
            "showPoints": "auto"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (origin) (rate(sbproxy_origin_requests_total{status=~\"5..\"}[5m])) / sum by (origin) (rate(sbproxy_origin_requests_total[5m]))",
          "legendFormat": "5xx - {{origin}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "refId": "B",
          "expr": "sum by (origin) (rate(sbproxy_origin_requests_total{status=~\"4..\"}[5m])) / sum by (origin) (rate(sbproxy_origin_requests_total[5m]))",
          "legendFormat": "4xx - {{origin}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "description": "Measures Per-Origin Error Rate. Runbook: docs/operator-runbook.md#origins. When red, inspect the matching component, confirm healthy range, and follow the rollback guidance if the spike follows a config change."
    },
    {
      "id": 4,
      "title": "Target Health State",
      "type": "timeseries",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 30
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "max": 2,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false,
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "pointSize": 5,
            "showPoints": "auto"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "healthy",
                  "index": 0
                },
                "1": {
                  "text": "degraded",
                  "index": 1
                },
                "2": {
                  "text": "excluded",
                  "index": 2
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sbproxy_target_health_state",
          "legendFormat": "{{origin}} {{target}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "description": "Per-target tri-state health on LiteLLM's 0/1/2 scale: 0 healthy, 1 degraded (circuit breaker half-open), 2 excluded from selection (probe-unhealthy, outlier-ejected, or breaker open). Sampled at scrape time from the same pipeline walk that renders GET /api/health/targets. Runbook: docs/operator-runbook.md#origins. When a target sits at 2, check /api/health/targets for which of the three mechanisms excluded it; when every target of an origin reads 2, the origin has no eligible upstream left."
    },
    {
      "id": 5,
      "title": "Fallback Origin Responses Served",
      "type": "timeseries",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 40
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false,
            "drawStyle": "line",
            "pointSize": 5,
            "showPoints": "auto"
          },
          "noValue": "No fallback has fired in this window. An origin with no fallback_origin configured never reports here."
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (origin, trigger) (rate(sbproxy_fallback_total[5m]))",
          "legendFormat": "{{origin}} - {{trigger}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "description": "Rate of fallback_origin responses served, by origin and by which trigger fired: `status` when the primary answered with a status listed under on_status, `error` when it failed outright. Every series here is a degraded response the client received instead of the primary's. Runbook: docs/operator-runbook.md#origins. When this rises, the primary behind that origin is failing; check the Per-Origin Error Rate panel above for the status it is answering with."
    },
    {
      "id": 6,
      "title": "Project Repositories Declared under origin_sources",
      "type": "timeseries",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 50
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true,
            "drawStyle": "line",
            "pointSize": 5,
            "showPoints": "auto"
          },
          "noValue": "No origin_sources block is configured on any node reporting here. Origins are hand written under origins:."
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "min",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tier, pinned) (sbproxy_origin_source_entries)",
          "legendFormat": "{{tier}} - pinned={{pinned}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "description": "Project repositories this fleet's configuration pulls, split by runtime tier and by whether the entry is pinned to an immutable revision (a full commit sha, or a tag spelled refs/tags/<name>). Set at config load, so a step change means a config was applied rather than that a fetch happened. Two readings to act on: the total dropping to zero means a fleet that should be composing project profiles has quietly stopped, and any non-zero pinned=false series under tier=production means a node is running a document that predates the pinning rule, because config load refuses that combination outright. Runbook: docs/operator-runbook.md#origins."
    },
    {
      "id": 7,
      "title": "Aggregation Entries by Outcome",
      "type": "timeseries",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 60
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true,
            "drawStyle": "line",
            "pointSize": 5,
            "showPoints": "auto"
          },
          "noValue": "No aggregator has reported here. Composition runs in one place; a fleet with no origin_sources block never writes this."
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "min",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (sbproxy_aggregate_entries)",
          "legendFormat": "{{outcome}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "description": "How the last aggregation round ended for each origin_sources entry. resolved is a repository read this round, unchanged is one whose remote sha had not moved so no clone happened, and failed is one that fell back to its last known good document or could not resolve at all. Every outcome is written on every round including the zeroes, so a failure that clears shows as the drop rather than as a series that stops moving. Two readings to act on: a non-zero failed series that persists across rounds names a repository the aggregator cannot reach, and unchanged staying at zero while rounds keep happening means the cheap ls-remote poll is not answering and every round is paying for a full clone. The entry name is deliberately not a label; it is in the aggregate structured log and in the sbproxy aggregate output. Runbook: docs/operator-runbook.md#origins."
    },
    {
      "id": 8,
      "title": "Aggregation Round Duration and Decision",
      "type": "timeseries",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 70
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true,
            "drawStyle": "line",
            "pointSize": 5,
            "showPoints": "auto"
          },
          "noValue": "No aggregator has reported here."
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "min",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(sbproxy_aggregate_compose_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 round duration",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "refId": "B",
          "expr": "sum by (outcome) (rate(sbproxy_aggregate_rounds_total[5m]))",
          "legendFormat": "{{outcome}} rounds/s",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "description": "Left axis is the p95 wall clock of one aggregation round, fetches included, and the two rate series are what each round decided. published means a composed document that differed from the last one and went to the config authority; unchanged means a byte-identical composition that published nothing, which is the steady state the change detector exists to produce and not a fault. Two readings to act on: p95 approaching origin_sources.aggregator.deadline_secs means the round is about to start reporting outstanding entries, and published tracking the round rate one for one means the change detector is not suppressing anything, which usually means a profile carries a value that differs on every read. Runbook: docs/operator-runbook.md#origins."
    },
    {
      "id": 9,
      "title": "Published Config Revision",
      "type": "timeseries",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 80
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true,
            "drawStyle": "line",
            "pointSize": 5,
            "showPoints": "auto"
          },
          "noValue": "No aggregator has reported here."
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "min",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sbproxy_aggregate_published_revision",
          "legendFormat": "revision",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "description": "The config-authority revision the aggregator last published. Zero means this aggregator has published nothing yet. A revision that stops advancing while entries keep resolving is the expected steady state, because an unchanged composition publishes nothing; read this panel together with Aggregation Entries by Outcome rather than alone. A revision that advances on every round is the thing to investigate, since each published revision is a full pipeline rebuild on every subscriber. Runbook: docs/operator-runbook.md#origins."
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  }
}
