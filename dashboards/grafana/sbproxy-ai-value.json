  "id": null,
  "uid": "sbproxy-ai-value",
  "title": "AI Value (per-tenant, per-credential, per-model)",
  "description": "Per-credential, multi-tenant, multi-model AI value tracking: spend, tokens, model latency, value-vs-waste by outcome, and success-only context-compression value. Ends with a trust row that says how much of the spend figure is measured: which price table produced each price, price-ceiling outcomes, token-estimate error by model, and semantic-cache dollars saved.",
  "tags": [
    "sbproxy",
    "ai",
    "finops"
  ],
  "style": "dark",
  "timezone": "",
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "version": 1,
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "title": "AI spend $/hr (selected tenants)",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Estimated AI spend per hour across the selected tenants.",
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(sbproxy_ai_cost_dollars_attributed_total{tenant_id=~\"$tenant\"}[5m]))*3600",
          "legendFormat": "spend/hr",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ]
    },
    {
