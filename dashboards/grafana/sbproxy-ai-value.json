    {
      "id": 21,
      "title": "Semantic cache cost saved ($/hr)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 44
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Dollars per hour avoided by semantic-cache hits, by model. Priced from the cached response's own usage block using the same cost table as spent cost, so saved and spent reconcile. A hit whose stored response carries no usage block still counts as a hit and contributes zero dollars, so this reads lower than the hit rate implies and is a floor on the saving, not the saving. The family names its tenant label tenant rather than tenant_id, so this panel joins the Tenant dropdown through that label; it carries no api_key_id at all, so a saving cannot be credited to a credential and the Credential dropdown does not apply. If this drops to zero while the cache hit rate holds, the cached entries stopped carrying usage blocks. The red not reported series sits at 1 when no priced cache hit has been recorded for the selected tenants. Runbook: docs/operator-runbook.md.",
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "not reported"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              },
              {
                "id": "unit",
                "value": "short"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model) (rate(sbproxy_ai_cost_saved_micros_total{tenant=~\"$tenant\"}[5m]))*3600/1000000",
          "legendFormat": "{{model}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "refId": "B",
          "expr": "absent(sbproxy_ai_cost_saved_micros_total{tenant=~\"$tenant\"})",
          "legendFormat": "not reported",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ]
    },
