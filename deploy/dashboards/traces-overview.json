{
  "annotations": {
    "list": []
  },
  "id": null,
  "title": "SBproxy Traces Overview",
  "description": "OTel trace search. Span names follow sbproxy.<pillar>.<verb>. Span and trace emission-rate panels are absent because the proxy exports spans without counting them; they return once the emission counters exist.",
  "tags": [
    "sbproxy",
    "wave1",
    "traces"
  ],
  "style": "dark",
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "prometheus_datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "selected": false,
          "text": "Prometheus",
          "value": "Prometheus"
        },
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "options": []
      },
      {
        "name": "tempo_datasource",
        "label": "Tempo",
        "type": "datasource",
        "query": "tempo",
        "current": {
          "selected": false,
          "text": "Tempo",
          "value": "Tempo"
        },
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "options": []
      },
      {
        "name": "pillar",
        "label": "Pillar",
        "type": "custom",
        "query": "intake,policy,action,transform,ledger,rail,audit,notify",
        "current": {
          "selected": false,
          "text": "All",
          "value": "$__all"
        },
        "includeAll": true,
        "multi": true,
        "options": [
          {
            "selected": true,
            "text": "All",
            "value": "$__all"
          },
          {
            "selected": false,
            "text": "intake",
            "value": "intake"
          },
          {
            "selected": false,
            "text": "policy",
            "value": "policy"
          },
          {
            "selected": false,
            "text": "action",
            "value": "action"
          },
          {
            "selected": false,
            "text": "transform",
            "value": "transform"
          },
          {
            "selected": false,
            "text": "ledger",
            "value": "ledger"
          },
          {
            "selected": false,
            "text": "rail",
            "value": "rail"
          },
          {
            "selected": false,
            "text": "audit",
            "value": "audit"
          },
          {
            "selected": false,
            "text": "notify",
            "value": "notify"
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 4,
      "title": "Recent error traces (Tempo)",
      "description": "Tempo TraceQL query for spans with status=error in the selected time range. Click a row to open the trace.",
      "type": "table",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "tempo",
        "uid": "${tempo_datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "align": "auto",
            "displayMode": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "footer": {
          "enablePagination": true,
          "show": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceqlSearch",
          "filters": [
            {
              "id": "service-name",
              "tag": "service.name",
              "operator": "=",
              "scope": "resource",
              "value": [
                "sbproxy"
              ]
            },
            {
              "id": "status",
              "tag": "status",
              "operator": "=",
              "scope": "intrinsic",
              "value": [
                "error"
              ]
            }
          ],
          "limit": 20,
          "tableType": "traces",
          "datasource": {
            "type": "tempo",
            "uid": "${tempo_datasource}"
          }
        }
      ]
    }
  ]
}
