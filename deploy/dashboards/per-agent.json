{
  "annotations": {
    "list": []
  },
  "id": null,
  "title": "SBproxy Per-Agent",
  "description": "Per-agent traffic, error rate, and route breakdowns. Every panel filters on all three agent dimensions sbproxy_requests_total carries, agent_class, agent_vendor, and agent_id, and groups by agent_class. The agent id box defaults to .* so the unfiltered view is the whole class.",
  "tags": [
    "sbproxy",
    "wave1",
    "per-agent"
  ],
  "style": "dark",
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "schemaVersion": 39,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "prometheus_datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "selected": false,
          "text": "Prometheus",
          "value": "Prometheus"
        },
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "options": []
      },
      {
        "name": "agent_class",
        "label": "Agent class",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus_datasource}"
        },
        "query": "label_values(sbproxy_requests_total, agent_class)",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "current": {
          "selected": false,
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "agent_vendor",
        "label": "Agent vendor",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus_datasource}"
        },
        "query": "label_values(sbproxy_requests_total{agent_class=~\"$agent_class\"}, agent_vendor)",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "current": {
          "selected": false,
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "agent_id",
        "label": "Agent id",
        "type": "textbox",
        "query": ".*",
        "current": {
          "selected": false,
          "text": ".*",
          "value": ".*"
        },
        "description": "Regex matched against the agent_id label on sbproxy_requests_total. Defaults to .* so every panel shows the whole selected class; type an id to narrow all four to that one agent. Ids beyond the cardinality budget are recorded as __other__.",
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Requests by agent class",
      "description": "Rate of inbound requests per agent_class, filtered by class and vendor.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "drawStyle": "line"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (agent_class) (rate(sbproxy_requests_total{agent_class=~\"$agent_class\",agent_vendor=~\"$agent_vendor\",agent_id=~\"$agent_id\"}[$__rate_interval]))",
          "legendFormat": "{{agent_class}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_datasource}"
          }
        }
      ]
    },
    {
      "id": 2,
      "title": "Error rate by agent class",
      "description": "5xx ratio per agent_class. Spikes here usually indicate a misbehaving integration vendor.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "drawStyle": "line"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (agent_class) (rate(sbproxy_requests_total{status=~\"5..\",agent_class=~\"$agent_class\",agent_vendor=~\"$agent_vendor\",agent_id=~\"$agent_id\"}[$__rate_interval])) / sum by (agent_class) (rate(sbproxy_requests_total{agent_class=~\"$agent_class\",agent_vendor=~\"$agent_vendor\",agent_id=~\"$agent_id\"}[$__rate_interval]))",
          "legendFormat": "{{agent_class}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_datasource}"
          }
        }
      ]
    },
    {
      "id": 3,
      "title": "Top origins for selected agents",
      "description": "Top 20 origins for the selected agent class / vendor combo. Click an origin to drill into Overview.",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "align": "auto",
            "displayMode": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "footer": {
          "enablePagination": false,
          "show": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(20, sum by (hostname, agent_class) (rate(sbproxy_requests_total{agent_class=~\"$agent_class\",agent_vendor=~\"$agent_vendor\",agent_id=~\"$agent_id\"}[$__rate_interval])))",
          "legendFormat": "{{hostname}} ({{agent_class}})",
          "format": "table",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_datasource}"
          }
        }
      ]
    },
    {
      "id": 4,
      "title": "Top tiers (rail) for selected agents",
      "description": "Top 20 payment rails the selected agents flow through. Useful when triaging rail-quorum issues.",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "align": "auto",
            "displayMode": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "footer": {
          "enablePagination": false,
          "show": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(20, sum by (payment_rail, agent_class) (rate(sbproxy_requests_total{agent_class=~\"$agent_class\",agent_vendor=~\"$agent_vendor\",agent_id=~\"$agent_id\"}[$__rate_interval])))",
          "legendFormat": "{{payment_rail}} ({{agent_class}})",
          "format": "table",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_datasource}"
          }
        }
      ]
    }
  ]
}
